int add(int a,int b) {
    return ((a%mod+b%mod))%mod;
}
int mul(int a,int b) {
    return ((a%mod)*(b%mod))%mod;
}
int fastpow(int r,int p) {
    int ret=1;
    while(p) {
        if(p&1) ret=mul(ret,r);
        p>>=1;
        r=mul(r,r);
    }
    return ret;
}
int modinverse(int n) {
    return fastpow(n,mod-2);
}
int Fact[N],invFact[N];
void pre() {
    Fact[0]=1;
    for(int i=1;i<N;i++) {
        Fact[i]=mul(Fact[i-1],i);
    }
    invFact[N-1]=modinverse(Fact[N-1]);
    for(int i=N-2;i>=0;i--) {
        invFact[i]=mul(invFact[i+1],i+1);
    }
}
int ncr(int n,int r) {
    if(r>n||r<0) return 0;
    return mul(mul(invFact[r],invFact[n-r]),Fact[n]);
}
int nCr(int n, int r) { // without modulo
    if (r < 0 || r > n) return 0;
    r = min(r, n - r);
    int result = 1;
    for (int i = 1; i <= r; ++i) {
        result = result * (n - r + i) / i;
    }
    return result;
}
int npr(int n,int r) {
    return mul(Fact[n],modinverse(Fact[n-r]));
}
