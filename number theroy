vector<int> sp(MAX);
vector<bool> isPrime(MAX, true);
vector<int> Prefix(MAX, 0),freq(MAX,0);
void Sieve()
{
    isPrime[0]=isPrime[1]  = false;
    for (int i = 2; i * i < MAX; ++i) {
        if (isPrime[i]) {
            for (int j = i * i; j < MAX; j += i) {
                isPrime[j] = false;
            }
        }
    }
    for (int i = 2; i < MAX; ++i) {
        if (isPrime[i]) {
            for (int j = i; j < MAX; j += i) {
                Prefix[i]+=freq[j];
            }
        }
        Prefix[i]+=Prefix[i-1];
    }
}int cnt_prfactors(int n) {
    int cnt = 0;
    for (int i : primes) {
        if(i*i>n)
            break;
        while (n%i==0) {
            n/=i;
            cnt++;
        }
    }
    if(n>1) {
       cnt++;
    }
    return cnt;
}
vector<pair<int,int>> prime_factor(int n) {
    vector<pair<int,int>> prf;
    for(int i=2;i*i<=n;i++) {
        int c=0;
        while(n%i==0) {
            c++;
            n/=i;
        }
        if(c>0)
            prf.push_back({i,c});
    }
    if(n>1) prf.push_back({n,1});
    return prf;
}
void spf() //O(N)
{
    for(int i = 0; i < MAX; i++) { sp[i] = i;}
    for(int i = 2; i*i <= MAX; i++) {
        for(int j = i*i; j < MAX; j += i) {
            sp[j] = min(i,sp[j]);
        }
    }
}
